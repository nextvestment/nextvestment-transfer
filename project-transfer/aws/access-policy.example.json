{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"Location","Effect":"Allow","Action":"s3:GetBucketLocation","Resource":"arn:aws:s3:::REPLACE_BUCKET"},
    {"Sid":"ListProject","Effect":"Allow","Action":"s3:ListBucket","Resource":"arn:aws:s3:::REPLACE_BUCKET","Condition":{"StringLike":{"s3:prefix":["project-share/","project-share/*"]}}},
    {"Sid":"ProjectObjects","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:AbortMultipartUpload","s3:ListMultipartUploadParts"],"Resource":"arn:aws:s3:::REPLACE_BUCKET/project-share/*"}
  ]
}
